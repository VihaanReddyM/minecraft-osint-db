# =============================================================================
# Core configuration
# =============================================================================

# PostgreSQL connection string (required for all crawl + worker commands).
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# DB connection pool sizing. For write-heavy crawls, set DB_POOL_MAX_SIZE >=
# (worker thread count) + 2.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# =============================================================================
# FlareSolverr (Cloudflare bypass) — optional
# =============================================================================

# Base URL of a running FlareSolverr instance.
MCOSINT_FLARESOLVERR_URL=http://localhost:8191

# Whether `mcosint http get` defaults to FlareSolverr.
# Note: `mcosint namemc crawl-friends-db` uses its own --use-flaresolverr flag;
# `mcosint namemc friends-mesh` uses USE_FLARESOLVERR (below).
MCOSINT_USE_FLARESOLVERR=false

# =============================================================================
# Discord notifications — optional
# =============================================================================

# Default Discord webhook for crawl start/finish/rate-limit embeds.
MCOSINT_DISCORD_WEBHOOK_URL=

# =============================================================================
# `mcosint namemc friends-mesh` (env-driven mesh worker)
# =============================================================================
# These variables are ONLY consumed by `friends-mesh`. The `crawl-friends-db`
# command and the `worker start` command both read their config from CLI flags
# (and from the core block above).

# Seeds: path to a text file with one UUID per line (# comments supported).
UUID_LIST_FILE_PATH=inputs/target_uuids.txt

# Traversal limits.
MAX_DEPTH=2
MAX_TOTAL_CALLS=                  # blank or <=0 = unlimited
MAX_FRIENDS_PER_USER=             # blank or <=0 = unlimited

# Output JSON path.
OUTPUT_PATH=output/friend_mesh.json

# If true, run `create_schema` at startup.
INIT_DB=false

# Threading. THREADS takes precedence over the legacy THREAD_COUNT for this
# worker.
THREADS=5

# Retry / 429 backoff.
RATE_LIMIT_BACKOFF_SECONDS=10
MAX_RETRIES_PER_UUID=3

# FlareSolverr (per-worker overrides; fall back to MCOSINT_FLARESOLVERR_URL).
USE_FLARESOLVERR=true
FLARESOLVERR_URL=http://localhost:8191

# Discord webhook (per-worker override; falls back to MCOSINT_DISCORD_WEBHOOK_URL).
DISCORD_WEBHOOK_URL=

# Optional: per-thread IP isolation. Set ONE of these. VPN_DIR takes
# precedence over PROXY_FILE_PATH if both are set. If neither is set, all
# threads share the host's outbound IP (legacy single-IP behavior).
#
# PROXY_FILE_PATH=inputs/proxies.txt     # one socks5:// or http:// URL per line, # comments OK
# VPN_DIR=./vpn/                         # directory of .ovpn files (Linux only)
# VPN_COUNT=                             # defaults to THREADS

# Randomized burst rate limiter (used ONLY by friends-mesh, not crawl-friends-db).
# After every (MIN_BURST_CALLS..MAX_BURST_CALLS) requests, the limiter sleeps
# for a uniform random time in [MIN_API_WAIT_TIME, MAX_API_WAIT_TIME] seconds.
# The Python defaults match these values, so running without .env produces
# the same operational shape.
MIN_API_WAIT_TIME=15.0
MAX_API_WAIT_TIME=45.0
MIN_BURST_CALLS=3
MAX_BURST_CALLS=8

# Per-call jitter between individual API requests (always applied).
PER_CALL_MIN_WAIT_SECONDS=0.3
PER_CALL_MAX_WAIT_SECONDS=1.0
