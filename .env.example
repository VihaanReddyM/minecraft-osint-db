# PostgreSQL connection string (required for all crawl commands)
# Format: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Crawler concurrency / performance
# These are used as fallback defaults for `mcosint namemc friends-mesh`.
# CLI flags (--threads, --request-delay, etc.) always take precedence.
# `crawl-friends-db` uses its own CLI flags directly; these env vars do not apply to it.
THREAD_COUNT=5
REQUEST_DELAY=1.0
MAX_DEPTH=2
MAX_TOTAL_REQUESTS=100
MAX_FRIENDS_PER_USER=50
MAX_RETRIES_PER_UUID=3

# Resume behavior
# If true, the crawler will ignore DB resume markers and fetch again.
FORCE_RECRAWL=false

# Rate limiting
RATE_LIMIT_BACKOFF_SECONDS=10

# DB pool sizing (should be >= THREAD_COUNT for write-heavy crawls)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Optional: FlareSolverr instance URL
# Used by `mcosint http get --use-flaresolverr` and `mcosint namemc friends-mesh`.
# friends-mesh: controlled by --use-flaresolverr / --no-use-flaresolverr flag (default: on).
# http get: controlled by --use-flaresolverr flag, or set MCOSINT_USE_FLARESOLVERR=true below.
MCOSINT_FLARESOLVERR_URL=http://localhost:8191

# Optional: enable FlareSolverr by default for `mcosint http get` (true/false).
# Note: friends-mesh has its own --use-flaresolverr flag independent of this setting.
MCOSINT_USE_FLARESOLVERR=false

# Optional: Discord webhook for crawl start/finish/rate-limit notifications
MCOSINT_DISCORD_WEBHOOK_URL=
