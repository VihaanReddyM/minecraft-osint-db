# PostgreSQL connection string (required for all crawl commands)
# Format: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Crawler concurrency / performance
# `crawl-friends-db` uses CLI flags directly; these vars do not apply to it.
THREAD_COUNT=5
REQUEST_DELAY=1.0
MAX_TOTAL_REQUESTS=100
MAX_RETRIES_PER_UUID=3

# Resume behavior
FORCE_RECRAWL=false

# Rate limiting
RATE_LIMIT_BACKOFF_SECONDS=10

# DB pool sizing (should be >= THREAD_COUNT for write-heavy crawls)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Optional: FlareSolverr instance URL
MCOSINT_FLARESOLVERR_URL=http://localhost:8191

# Optional: enable FlareSolverr by default for `mcosint http get` (true/false).
MCOSINT_USE_FLARESOLVERR=false

# Optional: Discord webhook for crawl start/finish/rate-limit notifications
MCOSINT_DISCORD_WEBHOOK_URL=

# ==============================================================================
# NameMC Friends Mesh Worker (env-driven, used by `mcosint namemc friends-mesh`)
# ==============================================================================

# Seeds: path to a text file with one UUID per line (# comments supported)
UUID_LIST_FILE_PATH=inputs/target_uuids.txt

# Mesh traversal
MAX_DEPTH=2

# Optional caps (<=0 or unset means unlimited)
MAX_TOTAL_CALLS=
MAX_FRIENDS_PER_USER=

# Output path for the mesh JSON
OUTPUT_PATH=output/friend_mesh.json

# If true, ensure DB schema at startup
INIT_DB=false

# Threading (THREADS takes precedence over THREAD_COUNT for the worker)
THREADS=5

# FlareSolverr for the worker (USE_FLARESOLVERR takes precedence over MCOSINT_USE_FLARESOLVERR)
USE_FLARESOLVERR=true
FLARESOLVERR_URL=http://localhost:8191

# Discord webhook for the worker (DISCORD_WEBHOOK_URL takes precedence over MCOSINT_DISCORD_WEBHOOK_URL)
DISCORD_WEBHOOK_URL=

# Randomized burst rate limiting
MIN_API_WAIT_TIME=15.0
MAX_API_WAIT_TIME=45.0
MIN_BURST_CALLS=3
MAX_BURST_CALLS=8

# Per-call jitter between individual API requests
PER_CALL_MIN_WAIT_SECONDS=0.3
PER_CALL_MAX_WAIT_SECONDS=1.0
